# Extraction model (vision). Self-hosted: see serving/docker-compose.vllm.yml
VLM_MODEL=vidoc
VLM_BASE_URL=http://localhost:8001/v1
VLM_API_KEY=

# Agent model (text, tool calling). Any OpenAI-compatible endpoint; empty = rules baseline.
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Optional dense retrieval, e.g. bge-m3 served by vLLM/Ollama, or text-embedding-3-small
EMBED_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
